{
  "name": "vfx-presentation-pages",
  "version": "1.0.0",
  "private": true,
  "description": "高阶视效地图 · 全屏演示页（成果与研究逻辑，不是 3D 舞台）",
  "type": "module",
  "scripts": {
    "assets": "python3 scripts/prepare-assets.py",
